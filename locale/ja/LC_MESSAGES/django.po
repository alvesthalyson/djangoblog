msgid "(In development, check your terminal for the email.)"
msgstr "(開発中は、メールはターミナルに表示されます。)"

msgid "<a href=\"%(login_url)s\">Log in</a> or <a href=\"%(register_url)s\">create an account</a> to join the conversation."
msgstr "<a href=\"%(login_url)s\">ログイン</a>するか、<a href=\"%(register_url)s\">アカウントを作成</a>して会話に参加しましょう。"

msgid "A door appears in the old library wall. What do you do?"
msgstr "古い図書室の壁にドアが現れました。あなたはどうしますか?"

msgid "A friend is blamed for something they did not do. You…"
msgstr "友達がやってもいないことで責められています。あなたは…"

msgid "A hilltop bonfire under open sky."
msgstr "広い空の下、丘の上のたき火。"

msgid "A lakeside cave lit by green lanterns."
msgstr "緑のランタンに照らされた湖畔の洞窟。"

msgid "A silent tower full of books."
msgstr "本がぎっしり詰まった静かな塔。"

msgid "A warm kitchen full of friends."
msgstr "友達でにぎわう温かいキッチン。"

msgid "About"
msgstr "紹介"

msgid "About me"
msgstr "私について"

msgid "About the blog"
msgstr "このブログについて"

msgid "Access Denied"
msgstr "アクセスが拒否されました"

msgid "Air"
msgstr "風"

msgid "Anything you'd like to tell me?"
msgstr "伝えたいことがあればどうぞ"

msgid "Back to the blog"
msgstr "ブログに戻る"

msgid "Back to the list"
msgstr "一覧に戻る"

msgid "Being the friend everyone could count on."
msgstr "誰もが頼れる友達であったこと。"

msgid "Bold, loyal and quick to stand up for others. You would open the door first and think about the hinges later."
msgstr "勇敢で忠実、誰かのためにすぐ立ち上がれる人。まずドアを開けて、蝶番のことは後で考えるタイプです。"

msgid "Building something that outlasts you."
msgstr "自分より長く残るものを築いたこと。"

msgid "Built with"
msgstr "使用技術"

msgid "By %(author)s"
msgstr "投稿者: %(author)s"

msgid "By %(author)s on %(date)s"
msgstr "%(date)s に %(author)s が投稿"

msgid "Cancel"
msgstr "キャンセル"

msgid "Catch the Golden Snitch"
msgstr "ゴールデン・スニッチを捕まえる"

msgid "Categories"
msgstr "カテゴリー"

msgid "Category"
msgstr "カテゴリー"

msgid "Close the quiz"
msgstr "テストを閉じる"

msgid "Comment deleted."
msgstr "コメントを削除しました。"

msgid "Comment posted!"
msgstr "コメントを投稿しました!"

msgid "Commenting as <strong>%(name)s</strong> · max 500 characters"
msgstr "<strong>%(name)s</strong> としてコメント · 500文字まで"

