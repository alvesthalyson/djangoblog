msgid "(In development, check your terminal for the email.)"
msgstr "(Em desenvolvimento, veja o e-mail no terminal.)"

msgid "<a href=\"%(login_url)s\">Log in</a> or <a href=\"%(register_url)s\">create an account</a> to join the conversation."
msgstr "<a href=\"%(login_url)s\">Entre</a> ou <a href=\"%(register_url)s\">crie uma conta</a> para participar da conversa."

msgid "A door appears in the old library wall. What do you do?"
msgstr "Uma porta aparece na parede da velha biblioteca. O que você faz?"

msgid "A friend is blamed for something they did not do. You…"
msgstr "Um amigo é acusado de algo que não fez. Você…"

msgid "A hilltop bonfire under open sky."
msgstr "Uma fogueira no alto da colina, sob o céu aberto."

msgid "A lakeside cave lit by green lanterns."
msgstr "Uma caverna à beira do lago iluminada por lanternas verdes."

msgid "A silent tower full of books."
msgstr "Uma torre silenciosa cheia de livros."

msgid "A warm kitchen full of friends."
msgstr "Uma cozinha aconchegante cheia de amigos."

